.container {
  padding: 0;      /*置顶 */
 background-color: #f8f8f8
}

/* 轮播图容器 */
.banner {
 width: 720rpx; /* 设置轮播图宽度为屏幕的90%，留出两侧的空间 */
 height: 350rpx; /* 设置固定高度，可根据需求调整 */
 margin: 0 auto; /* 居中显示 */
 overflow: visible; /* 确保内容不会被裁剪 */
}

/* 每个轮播项 */
.swiper-item {
 display: flex;
 justify-content: center; /* 图片水平居中 */
 align-items: center; /* 图片垂直居中 */
 overflow: visible; /* 确保图片不会被裁剪 */
}

/* 图片样式 */
.banner-image {
 width: 100%; /* 图片宽度占满轮播项 */
 height: 100%; /* 图片高度占满轮播项 */
 border-radius: 20rpx; /* 添加圆角效果（可选） */
 transition: transform 0.3s ease; /* 添加平滑过渡效果 */
}

/* 当前图片的样式 */
.swiper-item.current .banner-image {
 transform: scale(1); /* 当前图片正常显示 */
 z-index: 2; /* 提高层级 */
}

/* 非当前图片的样式 */
.swiper-item:not(.current) .banner-image {
 transform: scale(0.80); /* 缩小非当前图片 */
}

/* 公告栏样式 */

.notice-container {
 width: 720rpx;
 background: #fff;
 border-radius: 10px;
 border-bottom: 1rpx solid #eee;
}
.logo{
 margin-right: 20rpx;
}
.notice-bar {
 display: flex;
 align-items: center;
 padding: 20rpx 20rpx;
 height: 50rpx;
}

.notice-swiper {
 flex: 1;
 height: 40rpx;
}

.notice-text {
 font-size: 28rpx;
 color: #666;
 width: 100%;
 overflow: hidden;
 text-overflow: ellipsis;
 white-space: nowrap;
 padding-right: 20rpx;
}

/* 功能入口样式 */
.function-container {
 width: 720rpx;
 margin: 30rpx;
 display: flex;
 justify-content: space-around;
 background-color: #fff;
 border-radius: 10px;
 box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
 
 /* flex-wrap: wrap;  允许换行*/
}

.function-item {
 width:130rpx;
 border-radius: 50rpx;
 padding: 20rpx 20rpx;
 display: flex;
 flex-direction: column;
 align-items: center;

}

.function-item image {
 width: 85rpx;
 height: 85rpx;
 margin-bottom: 10rpx;
 border-radius: 16rpx;
}

.function-item text {
 font-size: 28rpx;
 color: rgb(0, 0, 0);
}

/* 通用区块样式 */
.section {
 width: 720rpx;
 margin: 30rpx auto;
 background: #fff;
 border-radius: 16rpx;
 padding: 28rpx;
 box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
 box-sizing: border-box;
}

.section-header {
 display: flex;
 justify-content: space-between;
 align-items: center;
 margin-bottom: 24rpx;
 padding-bottom: 16rpx;
 border-bottom: 2rpx solid #f0f0f0;
}

.section-title {
 font-size: 32rpx;
 font-weight: bold;
 color: #333;
}

.more-link {
 font-size: 24rpx;
 color: #1296db;
 display: flex;
 align-items: center;
 gap: 4rpx;
}

/* 热门景点样式 */
.scenic-list {
 display: flex;
 gap: 20rpx;
 overflow-x: auto;
 padding-bottom: 10rpx;
}

.scenic-list::-webkit-scrollbar {
 display: none;
}

.scenic-card {
 flex: 0 0 280rpx;
 background: #f9f9f9;
 border-radius: 12rpx;
 overflow: hidden;
 transition: transform 0.3s ease;
}

.scenic-card:hover {
 transform: translateY(-4rpx);
}

.scenic-image {
 width: 100%;
 height: 180rpx;
}

.scenic-info {
 padding: 16rpx;
}

.scenic-name {
 font-size: 28rpx;
 font-weight: bold;
 color: #333;
 margin-bottom: 8rpx;
 display: block;
}

.scenic-location {
 font-size: 22rpx;
 color: #666;
 margin-bottom: 12rpx;
 display: block;
 white-space: nowrap;
 overflow: hidden;
 text-overflow: ellipsis;
}

.scenic-stats {
 display: flex;
 gap: 20rpx;
 align-items: center;
 justify-content: space-between;
}

.stat-item {
 display: flex;
 align-items: center;
 gap: 6rpx;
}

.stat-icon {
 width: 22rpx;
 height: 22rpx;
}

.rank-icon {
 width: 40rpx;
 height: 40rpx;
}

.stat-text {
 font-size: 22rpx;
 color: #666;
}

/* 精选帖子样式 */
.post-list {
 display: flex;
 flex-direction: column;
 gap: 20rpx;
}

.post-card {
 background: #f9f9f9;
 border-radius: 12rpx;
 padding: 20rpx;
 transition: transform 0.3s ease;
}

.post-card:hover {
 transform: translateY(-4rpx);
}

.post-header {
 display: flex;
 align-items: center;
 margin-bottom: 12rpx;
}

.post-avatar {
 width: 48rpx;
 height: 48rpx;
 border-radius: 50%;
 margin-right: 12rpx;
}

.post-author {
 font-size: 24rpx;
 color: #333;
 font-weight: 500;
}

.post-title {
 font-size: 28rpx;
 font-weight: bold;
 color: #333;
 margin-bottom: 12rpx;
 display: block;
}

.post-content {
 font-size: 24rpx;
 color: #666;
 line-height: 1.5;
 margin-bottom: 16rpx;
 display: block;
 display: -webkit-box;
 -webkit-line-clamp: 3;
 -webkit-box-orient: vertical;
 overflow: hidden;
 text-overflow: ellipsis;
}

.post-stats {
 display: flex;
 gap: 30rpx;
 align-items: center;
}

/* 优惠活动样式 */
.promotion-list {
 display: flex;
 gap: 20rpx;
 overflow-x: auto;
 padding-bottom: 10rpx;
 width: 100%;
 box-sizing: border-box;
}

.promotion-list::-webkit-scrollbar {
 display: none;
}

.promotion-card {
 flex: 0 0 280rpx;
 background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
 border-radius: 12rpx;
 overflow: hidden;
 transition: transform 0.3s ease;
}

.promotion-card:hover {
 transform: translateY(-4rpx);
}

.promotion-image {
 width: 100%;
 height: 180rpx;
}

.promotion-info {
 padding: 16rpx;
}

.promotion-header {
 display: flex;
 justify-content: space-between;
 align-items: center;
 margin-bottom: 8rpx;
}

.promotion-title {
 font-size: 26rpx;
 font-weight: bold;
 color: #333;
 flex: 1;
 white-space: nowrap;
 overflow: hidden;
 text-overflow: ellipsis;
}

.promotion-discount {
 font-size: 32rpx;
 font-weight: bold;
 color: #ff4757;
 background: #fff3f3;
 padding: 4rpx 12rpx;
 border-radius: 8rpx;
 margin-left: 10rpx;
}

.promotion-description {
 font-size: 22rpx;
 color: #666;
 margin-bottom: 8rpx;
 display: block;
 line-height: 1.4;
}

.promotion-tickets {
 font-size: 20rpx;
 color: #888;
 margin-bottom: 6rpx;
 display: block;
 line-height: 1.3;
 white-space: nowrap;
 overflow: hidden;
 text-overflow: ellipsis;
}

.promotion-time {
 font-size: 20rpx;
 color: #999;
 display: block;
}


/* 底部样式 */
.container {
 padding-bottom: 40rpx;
}

/* 响应式调整 */
@media (max-width: 375px) {
 .section {
   padding: 20rpx;
   margin: 20rpx;
 }
 
 .scenic-card {
   flex: 0 0 240rpx;
 }
 
 .scenic-image {
   height: 160rpx;
 }
}

/* AI悬浮窗样式 */
.ai-float-button {
  position: fixed;
  width: 100rpx;
  height: 100rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  z-index: 9999;
  cursor: pointer;
  transition: all 0.3s ease;
}

.ai-float-button:hover {
  transform: scale(1.1);
  box-shadow: 0 6rpx 20rpx rgba(18, 150, 219, 0.6);
}

.ai-icon {
  width: 50rpx;
  height: 50rpx;
  margin-bottom: 6rpx;
}

.ai-text {
  font-size: 20rpx;
  color: #333;
  font-weight: 500;
}
