<view class="container">
 <!-- 轮播图 -->
<swiper 
  class="banner" 
  indicator-dots="true" 
  autoplay="true"  
  interval="3000" 
  duration="1000"
  circular="true"
  bindchange="onSwiperChange">
  
  <swiper-item 
    wx:for="{{banners}}" 
    wx:key="id" 
    class="swiper-item {{currentIndex === index ? 'current' : ''}}">
    
    <image 
      src="{{item.imageUrl}}" 
      mode="aspectFill" 
      class="banner-image"
      bindtap="onBannerTap" 
      data-id="{{item.id}}"/>
  </swiper-item>
</swiper>

  <!-- 公告栏 -->
  <view class="notice-container">
    <view class="notice-bar">
      <view class="logo">🔊</view>
      <swiper class="notice-swiper" 
        autoplay="true" 
        circular="true" 
        interval="4000"
        duration="1000">
        <swiper-item wx:for="{{notices}}" wx:key="id">
          <view class="notice-text">{{item.content}}</view>
        </swiper-item>
      </swiper>
    
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="function-container">
    <view class="function-item" 
      wx:for="{{functions}}" 
      wx:key="id"
      bindtap="onFunctionTap"
      data-url="{{item.url}}">
      <image src="{{item.icon}}"/>
      <text>{{item.name}}</text>
    </view>
  </view>

  <!-- 热门景点推荐 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">热门景点</text>
      <navigator url="/pages/attraction/attraction" class="more-link">
        <text>查看更多</text>
        <text>→</text>
      </navigator>
    </view>
    <view class="scenic-list">
      <navigator 
        wx:for="{{hotScenic}}" 
        wx:key="id"
        url="/pages/attraction/detail/detail?id={{item.id}}"
        class="scenic-card">
        <image src="{{item.image}}" mode="aspectFill" class="scenic-image"/>
        <view class="scenic-info">
          <text class="scenic-name">{{item.name}}</text>
          <text class="scenic-location">{{item.location}}</text>
          <view class="scenic-stats">
            <view class="stat-item">
              <text class="stat-icon">👀</text>
              <text class="stat-text">{{item.formattedViewCount}}</text>
            </view>
            <view class="stat-item">
              <text class="stat-icon">⭐</text>
              <text class="stat-text">{{item.rating}}</text>
            </view>
          </view>
        </view>
      </navigator>
    </view>
  </view>

  <!-- 精选帖子 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">精选帖子</text>
      <navigator url="/pages/forum/forum" class="more-link">
        <text>查看更多</text>
        <text>→</text>
      </navigator>
    </view>
    <view class="post-list">
      <navigator 
        wx:for="{{featuredPosts}}" 
        wx:key="id"
        url="/packageforum/pages/detail/detail?postId={{item.id}}"
        class="post-card">
        <view class="post-header">
          <image src="{{item.avatar}}" mode="aspectFill" class="post-avatar"/>
          <text class="post-author">{{item.author}}</text>
        </view>
        <text class="post-title">{{item.title}}</text>
        <text class="post-content">{{item.content}}</text>
        <view class="post-stats">
          <view class="stat-item">
            <text class="stat-icon">❤️</text>
            <text class="stat-text">{{item.likeCount}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-icon">💬</text>
            <text class="stat-text">{{item.commentCount}}</text>
          </view>
        </view>
      </navigator>
    </view>
  </view>

  <!-- 优惠活动 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">优惠活动</text>
      <text class="more-link">限时特惠</text>
    </view>
    <view class="promotion-list">
      <navigator 
        wx:for="{{promotions}}" 
        wx:key="id"
        url="{{item.scenicId ? '/pages/attraction/detail/detail?id=' + item.scenicId : ''}}"
        class="promotion-card"
        hover-class="none">
        <image src="{{item.image}}" mode="aspectFill" class="promotion-image"/>
        <view class="promotion-info">
          <view class="promotion-header">
            <text class="promotion-title">{{item.title}}</text>
            <text class="promotion-discount">¥{{item.discountValue}}</text>
          </view>
          <text class="promotion-description">{{item.description}}</text>
          <text class="promotion-tickets">适用门票：{{item.ticketNames}}</text>
          <text class="promotion-time">截止日期：{{item.endTime}}</text>
        </view>
      </navigator>
    </view>
  </view>
</view> 