<view class="container">
  <!-- 帖子列表 -->
  <block wx:for="{{posts}}" wx:key="_id">
    <view class="post-card" bindtap="navigateToDetail" data-post-id="{{item._id}}">
      <view class="userinfo">
        <!-- 头像 -->
        <image class="avatar" src="{{item.avatarUrl}}"></image>
        <!-- 用户详情 -->
        <view class="user-details">
          <!-- 昵称 -->
          <text class="username">{{item.nickName}}</text>
          <!-- Uid -->
          <text class="user-id">Uid: {{item.userId}}</text>
        </view>
        <!-- 用户信息 -->
        <view class="post-meta">
          <text class="post-time">{{item.formattedTime}}</text>
        </view>
      </view>
      <!-- 标题 -->
      <view class="post-title">{{item.title}}</view>
      <!-- 描述 -->
      <view class="post-description">{{item.description}}</view>
      <!-- 图片 -->
      <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
        <image
          wx:for="{{item.images}}"
          wx:key="index"
          wx:if="{{index < 3}}"
          src="{{item}}"
          mode="aspectFill"
          class="post-image"
        ></image>
      </view>

      <!-- 点赞和评论 -->
      <view class="post-actions">
        <!-- 点赞按钮 -->
        <button
          class="like-btn"
          bindtap="handleLike"
          data-post-id="{{item._id}}"
        >
          <image class="icon" src="/images/contact/like.png"></image> {{item.likeCount || 0}}
        </button>
        <!-- 评论按钮 -->
        <button
          class="comment-btn"
          bindtap="showComments"
          data-post-id="{{item._id}}"
        >
          <image class="icon" src="/images/contact/comment.png"></image> {{item.commentCount || 0}}
        </button>
      </view>
    </view>
  </block>
</view>