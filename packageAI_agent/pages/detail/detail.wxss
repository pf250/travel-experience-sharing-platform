.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 聊天头部 */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  background-color: #1296db;
  padding: 0 30rpx;
  color: white;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.back-button {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  font-weight: bold;
}

.chat-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

.header-right {
  width: 60rpx;
}

/* 聊天内容区域 */
.chat-content {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 消息项 */
.message-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  max-width: 80%;
}

/* AI消息 */
.ai-message {
  align-self: flex-start;
  flex-direction: row;
}

/* 用户消息 */
.user-message {
  align-self: flex-end;
  flex-direction: row-reverse;
}

/* 头像 */
.message-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.message-avatar image {
  width: 100%;
  height: 100%;
}

/* 消息气泡 */
.message-bubble {
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background-color: white;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

.user-bubble {
  background-color: #1296db;
  color: white;
}

/* 消息文本 */
.message-text {
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}

.user-bubble .message-text {
  color: white;
}

/* 加载中 */
.loading-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 10rpx 0;
  align-self: center;
}

.loading-spinner {
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid rgba(18, 150, 219, 0.3);
  border-top: 3rpx solid #1296db;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  font-size: 24rpx;
  color: #666;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  background-color: white;
  border-top: 1rpx solid #eee;
}

.input-box {
  flex: 1;
  height: 70rpx;
  padding: 0 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 35rpx;
  font-size: 28rpx;
  background-color: #f9f9f9;
}

.send-button {
  width: 120rpx !important;
  height: 70rpx !important;
  border-radius: 35rpx !important;
  background-color: #4CAF50 !important;
  color: white !important;
  font-size: 28rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border: none !important;
  position: relative !important;
  z-index: 1000 !important;
  cursor: pointer !important;
}

.send-button:disabled {
  background-color: #ccc !important;
  color: #666 !important;
}

/* 滚动条样式 */
.chat-content::-webkit-scrollbar {
  width: 4rpx;
}

.chat-content::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 2rpx;
}

.chat-content::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 2rpx;
}

.chat-content::-webkit-scrollbar-thumb:hover {
  background: #a8a8a8;
}
