<!--packageHome/pages/ranking/ranking.wxml-->
<view class="ranking-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">🔥 热度排行榜</text>
    <text class="page-subtitle">根据景区浏览量计算热度值</text>
  </view>
  
  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading-container">
    <text>加载中...</text>
  </view>
  
  <!-- 无数据提示 -->
  <view wx:elif="{{!isLoading && scenicList.length === 0}}" class="empty-container">
    <text>暂无景区数据</text>
  </view>
  
  <!-- 排行榜列表 -->
  <view wx:else class="ranking-list">
    <view wx:for="{{scenicList}}" wx:key="_id" class="ranking-item {{index === 0 ? 'rank-first' : index === 1 ? 'rank-second' : index === 2 ? 'rank-third' : ''}}" bindtap="navigateToDetail" data-id="{{item._id}}">
      <!-- 排名 -->
      <view class="rank-number">
        <image wx:if="{{index === 0}}" src="/images/rank/NO.1.png" mode="aspectFill"></image>
        <image wx:elif="{{index === 1}}" src="/images/rank/NO.2.png" mode="aspectFill"></image>
        <image wx:elif="{{index === 2}}" src="/images/rank/NO.3.png" mode="aspectFill"></image>
        <text wx:else>{{index + 1}}</text>
      </view>
      
      <!-- 景区信息 -->
      <view class="scenic-info">
        <!-- 景区图片 -->
        <view class="scenic-image">
          <image src="{{item.images && item.images.length > 0 ? item.images[0] : 'https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=scenic%20spot%20placeholder%20image&image_size=square'}}"></image>
        </view>
        
        <!-- 景区详情 -->
        <view class="scenic-details">
          <text class="scenic-name">{{item.name}}</text>
          <text class="scenic-address">{{item.address}}</text>
          <view class="scenic-stats">
            <text class="heat-value">🔥热度值: {{item.formattedHeat}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>