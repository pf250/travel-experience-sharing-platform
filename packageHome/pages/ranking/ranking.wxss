/* packageHome/pages/ranking/ranking.wxss */
.ranking-container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 页面标题 */
.page-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.page-subtitle {
  font-size: 22rpx;
  color: #999;
  display: block;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
  font-size: 24rpx;
}

/* 无数据提示 */
.empty-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
  font-size: 24rpx;
}

/* 排行榜列表 */
.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 排行榜项 */
.ranking-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s ease;
  width: 100%;
  box-sizing: border-box;
}

.ranking-item:active {
  transform: scale(0.98);
}

/* 排名 */
.rank-number {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-number text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  background-color: #e0e0e0;
}

.rank-number image {
  width: 60rpx;
  height: 60rpx;
}

/* 景区信息 */
.scenic-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

/* 景区图片 */
.scenic-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.scenic-image image {
  width: 100%;
  height: 100%;
}

/* 景区详情 */
.scenic-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.scenic-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scenic-address {
  font-size: 22rpx;
  color: #666;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 30rpx;
  max-height: 30rpx;
  max-width: 100%;
  box-sizing: border-box;
}

/* 景区统计信息 */
.scenic-stats {
  display: flex;
  gap: 20rpx;
  margin-top: 4rpx;
}

.view-count {
  font-size: 20rpx;
  color: #999;
}

.heat-value {
  font-size: 20rpx;
  color: #ff6b6b;
  font-weight: bold;
}

/* 前三名特殊样式 */
.rank-first {
  background: linear-gradient(135deg, #fff3cd 0%, #fff9e6 100%);
  border: 1rpx solid #ffeeba;
}

.rank-second {
  background: linear-gradient(135deg, #e2e3e5 0%, #f8f9fa 100%);
  border: 1rpx solid #d3d3d3;
}

.rank-third {
  background: linear-gradient(135deg, #f1e3d3 0%, #f9f2ec 100%);
  border: 1rpx solid #e6d7c3;
}