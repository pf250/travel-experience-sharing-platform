/* packageHome/pages/demandwall/demandwall.wxss */
/* 全局样式 */
page {
  background-color: #f8f9fa;
}

/* 容器样式 */
.rules-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
  padding: 30rpx 20rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰元素 */
.top-decoration,
.bottom-decoration {
  position: absolute;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%);
  z-index: 1;
}

.top-decoration {
  top: 0;
  border-radius: 0 0 30rpx 30rpx;
  box-shadow: 0 2rpx 15rpx rgba(79, 172, 254, 0.3);
}

.bottom-decoration {
  bottom: 0;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -2rpx 15rpx rgba(79, 172, 254, 0.3);
}

/* 头部样式 */
.header {
  text-align: center;
  margin: 50rpx 0 40rpx;
  padding: 40rpx 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 2;
  backdrop-filter: blur(10rpx);
}

.header-icon {
  margin-bottom: 25rpx;
  animation: pulse 2s infinite;
}

.icon-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  box-shadow: 0 4rpx 15rpx rgba(79, 172, 254, 0.4);
}

.icon-text {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 15rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.subtitle {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 规则列表 */
.rules-list {
  margin-bottom: 50rpx;
  position: relative;
  z-index: 2;
}

/* 规则项 */
.rule-item {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  margin-bottom: 25rpx;
  padding: 35rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(10rpx);
}

.rule-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 6rpx 0 0 6rpx;
}

.rule-item:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.12);
}

.rule-item:active {
  transform: translateY(0);
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
}

/* 规则头部 */
.rule-header {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f4f8;
}

.rule-number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(79, 172, 254, 0.4);
}

.rule-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.rule-icon {
  margin-left: 20rpx;
}

.icon {
  font-size: 32rpx;
  animation: bounce 1s infinite;
}

/* 规则内容 */
.rule-content {
  line-height: 1.7;
  padding-left: 10rpx;
}

.rule-text {
  font-size: 26rpx;
  color: #555;
  white-space: pre-wrap;
  line-height: 1.7;
}

/* 页脚 */
.footer {
  text-align: center;
  padding: 40rpx 30rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 2;
  backdrop-filter: blur(10rpx);
}

.footer-icon {
  margin-bottom: 20rpx;
}

.heart-icon {
  font-size: 40rpx;
  animation: heartbeat 1.5s infinite;
}

.footer-text {
  font-size: 28rpx;
  color: #555;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.footer-subtext {
  font-size: 24rpx;
  color: #999;
}

/* 动画效果 */
@keyframes pulse {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
  100% {
    transform: scale(1);
  }
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-5rpx);
  }
  60% {
    transform: translateY(-3rpx);
  }
}

@keyframes heartbeat {
  0% {
    transform: scale(1);
  }
  14% {
    transform: scale(1.3);
  }
  28% {
    transform: scale(1);
  }
  42% {
    transform: scale(1.3);
  }
  70% {
    transform: scale(1);
  }
}

/* 响应式设计 */
@media (min-width: 750rpx) {
  .rules-container {
    padding: 40rpx 50rpx;
  }
  
  .header {
    padding: 50rpx 40rpx;
    margin: 60rpx 0 50rpx;
  }
  
  .rule-item {
    padding: 45rpx;
    margin-bottom: 30rpx;
  }
  
  .title {
    font-size: 44rpx;
  }
  
  .subtitle {
    font-size: 28rpx;
  }
  
  .rule-title {
    font-size: 32rpx;
  }
  
  .rule-text {
    font-size: 28rpx;
  }
}

/* 滚动条样式 */
::-webkit-scrollbar {
  width: 8rpx;
}

::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 10rpx;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 10rpx;
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(135deg, #3a86ff 0%, #00b4d8 100%);
}
