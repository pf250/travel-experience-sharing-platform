/* packageHome/pages/resource/resource.wxss */

/* 全局样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

/* 页面头部 */
.header {
  background: linear-gradient(135deg, #1296db 0%, #1e88e5 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  color: white;
  box-shadow: 0 10rpx 30rpx rgba(18, 150, 219, 0.3);
}

.title {
  margin-bottom: 15rpx;
}

.title-text {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
}

.title-subtext {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 10rpx;
  display: block;
}

.description {
  font-size: 28rpx;
  opacity: 0.8;
  line-height: 1.5;
}

/* 功能容器 */
.feature-container {
  margin-bottom: 40rpx;
}

/* 分类区块 */
.category-section {
  margin-bottom: 40rpx;
}

.category-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #e0e0e0;
}

.category-icon {
  font-size: 40rpx;
  margin-right: 15rpx;
}

.category-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 功能列表 */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 功能卡片 */
.feature-card {
  background: white;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.feature-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(180deg, #1296db 0%, #1e88e5 100%);
}

.feature-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

/* 功能头部 */
.feature-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.feature-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

/* 状态标签 */
.feature-status {
  margin-left: 15rpx;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.status-badge.development {
  background: #e3f2fd;
  color: #1976d2;
}

.status-badge.design {
  background: #f3e5f5;
  color: #7b1fa2;
}

.status-badge.planning {
  background: #fff3e0;
  color: #ef6c00;
}

.status-badge.research {
  background: #e8f5e8;
  color: #2e7d32;
}

/* 功能描述 */
.feature-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

/* 功能底部 */
.feature-footer {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.eta-info {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.eta-label {
  color: #999;
  margin-right: 10rpx;
}

.eta-value {
  color: #333;
  font-weight: 500;
}

/* 进度条容器 */
.progress-container {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1296db 0%, #1e88e5 100%);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
  min-width: 80rpx;
  text-align: right;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
  padding: 30rpx 0;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.tip-text {
  font-size: 26rpx;
  color: #999;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .container {
    padding: 15rpx;
  }
  
  .header {
    padding: 30rpx;
  }
  
  .title-text {
    font-size: 36rpx;
  }
  
  .feature-card {
    padding: 24rpx;
  }
}
