<view class="container">
  <!-- 帖子详情 -->
  <view class="post-detail">
    <view class="userinfo">
      <view class="userinfo-top">
        <!-- 头像 -->
        <image class="avatar" src="{{post.avatarUrl}}"></image>
        <!-- 昵称 -->
        <text class="username">{{post.nickName}}</text>
      </view>
      <!-- 用户信息 -->
      <view class="post-meta">
        <text class="post-author">Uid: {{post.userId}}</text>
        <text class="post-time">时间：{{post.formattedTime}}</text>
      </view>
    </view>
    <!-- 图片 -->
    <view class="post-images-container" wx:if="{{post.images.length > 0}}">
      <!-- 数字指示器 -->
      <view class="image-indicator">
        <text class="indicator-text">{{currentImageIndex + 1}}/{{post.images.length}}</text>
      </view>
      <scroll-view class="post-images-scroll" scroll-x="true" enable-flex="true" bindscroll="onImageScroll" scroll-with-animation="true">
        <view class="post-images-wrapper">
          <image
            wx:for="{{post.images}}"
            wx:key="index"
            src="{{item}}"
            mode="aspectFill"
            class="post-image"
            bindtap="previewImage"
            data-index="{{index}}"
          ></image>
        </view>
      </scroll-view>
      <!-- 小灰点指示器 -->
      <view class="dots-indicator">
        <view 
          wx:for="{{post.images}}" 
          wx:key="index"
          class="dot {{index === currentImageIndex ? 'active' : ''}}"
        ></view>
      </view>
    </view>
    <!-- 标题 -->
    <view class="post-title">{{post.title}}</view>
    <!-- 描述 -->
    <view class="post-description">{{post.description}}</view>

    <!-- 点赞和评论 -->
    <view class="post-actions">
      <!-- 点赞按钮 -->
      <button
        class="like-btn"
        bindtap="handleLike"
        data-post-id="{{post._id}}"
      >
        <text>👍</text> {{post.likeCount || 0}}
      </button>
      <!-- 评论按钮 -->
      <button
        class="comment-btn"
        bindtap="toggleCommentSection"
        data-post-id="{{post._id}}"
      >
        <text>💬</text> {{post.commentCount || 0}}
      </button>
    </view>
    <!-- 评论区域 -->
    <view class="comments-section">
      <view class="comment-list">
        <block wx:for="{{comments}}" wx:key="_id">
          <view class="comment-item" data-comment-id="{{item._id}}">
            <!-- 头像 -->
            <image class="comment-avatar" src="{{item.avatarUrl}}"></image>
            <view class="comment-content-wrapper">
              <view class="comment-header">
                <!-- 昵称 -->
                <text class="comment-nickname">{{item.nickName}}</text>
              </view>
              <!-- 评论内容 -->
                <text class="comment-content">{{item.parentId ? '回复 @' + item.replyTargetAuthor + '：' : ''}}{{item.content}}</text>
              <view class="comment-footer">
                <!-- 评论时间 -->
                <text class="comment-time">{{item.formattedTime}}</text>
                <!-- 回复按钮 -->
                <button class="reply-btn" bindtap="showReplyInput" data-comment-id="{{item._id}}" data-comment-author="{{item.nickName}}">
                  回复
                </button>
              </view>
            </view>
          </view>
          <!-- 回复列表 -->
          <view class="replies-list" wx:if="{{item.replies && item.replies.length > 0}}">
            <block wx:for="{{item.isExpanded ? item.replies : [item.replies[0]]}}" wx:key="_id">
              <view class="reply-item">
                <!-- 头像 -->
                <image class="comment-avatar" src="{{item.avatarUrl}}"></image>
                <view class="comment-content-wrapper">
                  <view class="comment-header">
                    <!-- 昵称 -->
                    <text class="comment-nickname">{{item.nickName}}</text>
                  </view>
                  <!-- 评论内容 -->
                <text class="comment-content">{{item.isReplyToReply ? '回复 @' + item.replyTargetAuthor + '：' : ''}}{{item.content}}</text>
                  <view class="comment-footer">
                    <!-- 评论时间 -->
                    <text class="comment-time">{{item.formattedTime}}</text>
                    <!-- 回复按钮 -->
                    <button class="reply-btn" bindtap="showReplyInput" data-comment-id="{{item._id}}" data-comment-author="{{item.nickName}}">
                      回复
                    </button>
                  </view>
                </view>
              </view>
            </block>
            <!-- 展开/折叠按钮 -->
            <view class="reply-toggle" wx:if="{{item.replies.length > 0}}">
              <button bindtap="toggleReplyExpanded" data-comment-id="{{item._id}}" class="toggle-btn">
                {{item.isExpanded ? '收起回复' : '查看全部回复 (' + item.replies.length + ')'}}
              </button>
            </view>
          </view>

        </block>
      </view>
    </view>
  </view>
  
  <!-- 弹出式评论输入框 -->
  <view class="comment-input-popup" wx:if="{{showCommentInput}}">
    <view class="comment-input-content">
      <textarea
        placeholder="发表评论..."
        value="{{newComment}}"
        bindinput="onCommentInput"
        focus="{{true}}"
        auto-height="{{true}}"
        style="min-height: 120rpx;"
      />
      <view class="comment-input-buttons">
        <button bindtap="hideCommentInput" class="cancel-btn">
          取消
        </button>
        <button bindtap="handleComment" data-post-id="{{post._id}}" class="submit-btn">
          发表
        </button>
      </view>
    </view>
  </view>
  
  <!-- 弹出式回复输入框 -->
  <view class="comment-input-popup" wx:if="{{showReplyInput}}">
    <view class="comment-input-content">
      <textarea
        placeholder="回复 {{replyTargetAuthor}}..."
        value="{{newReply}}"
        bindinput="onReplyInput"
        focus="{{true}}"
        auto-height="{{true}}"
        style="min-height: 120rpx;"
      />
      <view class="comment-input-buttons">
        <button bindtap="hideReplyInput" class="cancel-btn">
          取消
        </button>
        <button bindtap="handleReply" data-comment-id="{{replyTargetId}}" class="submit-btn">
          回复
        </button>
      </view>
    </view>
  </view>
</view>