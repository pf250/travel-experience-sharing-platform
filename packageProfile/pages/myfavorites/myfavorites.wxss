/* packageProfile/pages/myfavorites/myfavorites.wxss */

.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 页面标题 */
.page-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
  color: #333;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  font-size: 28rpx;
  color: #999;
}

/* 无购票记录 */
.empty-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  font-size: 28rpx;
  color: #999;
}

/* 购票记录列表 */
.ticket-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 购票记录项 */
.ticket-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 景区信息 */
.ticket-header {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
  cursor: pointer;
}

.scenic-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.ticket-name {
  font-size: 24rpx;
  color: #666;
}

/* 购票详情 */
.ticket-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.label {
  color: #999;
  width: 160rpx;
}

.value {
  color: #333;
  flex: 1;
}

.value.total {
  font-weight: bold;
  color: #ff6b35;
}

/* 状态样式 */
.status-1 {
  color: #4CAF50;
}

.status-2 {
  color: #2196F3;
}

.status-3 {
  color: #999;
}

/* 操作按钮 */
.ticket-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.refund-btn {
  background-color: #ff6b35;
  color: #fff;
  border-radius: 8rpx;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  border: none;
}

.no-action {
  color: #999;
  font-size: 24rpx;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .container {
    padding: 16rpx;
  }
  
  .ticket-item {
    padding: 20rpx;
  }
  
  .info-row {
    font-size: 22rpx;
  }
  
  .label {
    width: 140rpx;
  }
}