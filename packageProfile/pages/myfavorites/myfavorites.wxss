/* packageProfile/pages/myfavorites/myfavorites.wxss */

.user-manage-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.content {
  padding: 20rpx;
}

/* 标签页样式 */
.tabs {
  display: flex;
  background: white;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-item.active {
  color: #ff6b35;
  font-weight: bold;
  position: relative;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #ff6b35;
  border-radius: 2rpx;
}

/* 页面标题 */
.page-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
  color: #333;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 购票记录列表 */
.ticket-list {
  padding: 20rpx;
}

/* 购票记录项 */
.ticket-item {
  background: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 景区信息 */
.ticket-header {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
  cursor: pointer;
}

.scenic-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.ticket-name {
  font-size: 24rpx;
  color: #666;
}

/* 购票详情 */
.ticket-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.label {
  color: #999;
  width: 160rpx;
}

.value {
  color: #333;
  flex: 1;
}

.value.total {
  font-weight: bold;
  color: #ff6b35;
}

/* 状态样式 */
.status-1 {
  color: #4CAF50;
}

.status-2 {
  color: #2196F3;
}

.status-3 {
  color: #999;
}

/* 操作按钮 */
.ticket-actions {
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 20rpx;
  text-align: right;
}

.refund-btn {
  background-color: #ff6b35;
  color: #fff;
  border-radius: 8rpx;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  border: none;
  white-space: nowrap;
  display: inline-block;
  width: auto !important;
  min-width: auto !important;
  flex: none !important;
}

.refund-btn::after {
  border: none;
}

.delete-btn {
  background-color: #f44336;
  color: #fff;
  border-radius: 8rpx;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  border: none;
  white-space: nowrap;
  display: inline-block;
  width: auto !important;
  min-width: auto !important;
  flex: none !important;
}

.delete-btn::after {
  border: none;
}

.no-action {
  color: #999;
  font-size: 24rpx;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .content {
    padding: 16rpx;
  }
  
  .ticket-item {
    padding: 20rpx;
  }
  
  .info-row {
    font-size: 22rpx;
  }
  
  .label {
    width: 140rpx;
  }
}