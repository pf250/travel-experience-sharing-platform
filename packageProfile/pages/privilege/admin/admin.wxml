<!-- packageProfile/pages/privilege/admin/admin.wxml -->
<view class="admin-container">
  <view class="header">
    <text class="title">管理中心</text>
  </view>

  <view class="menu-list">
    <view 
      wx:for="{{menuItems}}" 
      wx:key="id"
      class="menu-item"
      data-path="{{item.path}}"
      bindtap="navigateToPage"
    >
      <view class="menu-icon {{item.id}}">
        <text class="icon">{{item.icon === 'user' ? '👤' : '🏪'}}</text>
      </view>
      <view class="menu-content">
        <text class="menu-title">{{item.title}}</text>
        <text class="menu-desc">点击进入管理</text>
      </view>
      <view class="menu-arrow">
        <text>›</text>
      </view>
    </view>
  </view>
</view>