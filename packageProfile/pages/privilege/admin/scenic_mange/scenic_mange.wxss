/* packageProfile/pages/privilege/admin/scenic_mange/scenic_mange.wxss */

/* 全局样式 */
page {
  background-color: #f8f9fa;
}

/* 容器样式 */
.scenic-manage-container {
  min-height: 100vh;
  padding: 30rpx 20rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
}

/* 头部样式 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 30rpx 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(10rpx);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.subtitle {
  font-size: 24rpx;
  color: #666;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 500rpx;
}

.loading {
  font-size: 28rpx;
  color: #666;
  animation: pulse 1.5s infinite;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  animation: bounce 2s infinite;
}

.empty-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.empty-subtext {
  font-size: 24rpx;
  color: #999;
  max-width: 80%;
  line-height: 1.5;
}

/* 景区列表 */
.scenic-list {
  margin-bottom: 40rpx;
}

/* 景区项 */
.scenic-item {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 25rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  backdrop-filter: blur(10rpx);
  position: relative;
  overflow: hidden;
}

.scenic-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 6rpx 0 0 6rpx;
}

.scenic-item:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.12);
}

/* 景区头部 */
.scenic-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.scenic-info {
  flex: 1;
  margin-right: 20rpx;
}

.scenic-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.scenic-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 15rpx;
}

.scenic-address {
  font-size: 24rpx;
  color: #666;
  flex: 1;
  min-width: 200rpx;
}

.scenic-status {
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 15rpx;
}

.scenic-status.open {
  background-color: #e6f7ee;
  color: #07c160;
}

.scenic-status.closed {
  background-color: #fff2f0;
  color: #ff4d4f;
}

.scenic-actions {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
  min-width: 160rpx;
}

.scenic-actions button {
  font-size: 20rpx;
  padding: 10rpx 18rpx !important;
  border-radius: 15rpx !important;
  min-width: 70rpx !important;
  max-width: 80rpx !important;
  width: auto !important;
  font-weight: normal !important;
  margin: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  height: auto !important;
  line-height: normal !important;
}

.action-btn {
  font-size: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: 15rpx;
  min-width: 70rpx;
  max-width: 80rpx;
  width: auto;
  font-weight: normal;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: auto;
  line-height: normal;
}

.action-btn.edit {
  background-color: #e6f7ff;
  color: #1890ff;
  border: 1rpx solid #91d5ff;
}

.action-btn.delete {
  background-color: #fff2f0;
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
}



/* 景区统计信息 */
.scenic-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 10rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  font-size: 22rpx;
  color: #888;
  display: flex;
  align-items: center;
  gap: 5rpx;
}

/* 底部提示 */
.footer-tip {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 15rpx;
  padding: 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(10rpx);
}

.tip-text {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

/* 动画效果 */
@keyframes pulse {
  0% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
  100% {
    opacity: 1;
  }
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-20rpx);
  }
  60% {
    transform: translateY(-10rpx);
  }
}

/* 响应式设计 */
@media (min-width: 750rpx) {
  .scenic-manage-container {
    padding: 40rpx 50rpx;
  }
  
  .scenic-item {
    padding: 40rpx;
    margin-bottom: 30rpx;
  }
  
  .scenic-name {
    font-size: 36rpx;
  }
  
  .scenic-address {
    font-size: 26rpx;
  }
  
  .scenic-description text {
    font-size: 26rpx;
  }
  
  .stat-item {
    font-size: 24rpx;
  }
}

/* 滚动条样式 */
::-webkit-scrollbar {
  width: 8rpx;
}

::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 10rpx;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  border-radius: 10rpx;
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(135deg, #3a86ff 0%, #00b4d8 100%);
}