<!-- packageProfile/pages/privilege/admin/user_manage/user_manage.wxml -->
<view class="user-manage-container">
  <!-- 标签页 -->
  <view class="tabs">
    <view 
      wx:for="{{tabs}}" 
      wx:key="index"
      class="tab-item {{tabIndex === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onTabChange"
    >
      {{item}}
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content">
    <view wx:if="{{loading}}" class="loading">
      <text>加载中...</text>
    </view>
    
    <view wx:elif="{{users.length === 0}}" class="empty">
      <text>暂无数据</text>
    </view>
    
    <view wx:else class="users-list">
      <view wx:for="{{users}}" wx:key="userId" class="user-card">
        <!-- 用户信息 -->
        <view class="user-info">
          <image class="avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <view class="user-details">
            <text class="nickname">{{item.nickName}}</text>
            <text class="user-id">用户ID: {{item.userId}}</text>
            <text class="time">{{item.formattedTime}}</text>
          </view>
          <view class="role-tag {{item.role === 'admin' ? 'role-admin' : item.role === 'merchant' ? 'role-merchant' : 'role-user'}}">
            {{item.roleText}}
          </view>
        </view>
      </view>
    </view>
  </view>
</view>