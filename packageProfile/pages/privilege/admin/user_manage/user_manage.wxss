/* packageProfile/pages/privilege/admin/user_manage/user_manage.wxss */
.user-manage-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.content {
  padding: 20rpx;
}

/* 标签页样式 */
.tabs {
  display: flex;
  background: white;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.tab-item.active {
  color: #07c160;
  font-weight: bold;
  position: relative;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #07c160;
  border-radius: 2rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 用户列表 */
.users-list {
  padding: 20rpx;
}

.user-card {
  background: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-details {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.user-id {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.time {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 角色标签 */
.role-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.role-admin {
  background-color: #e3f2fd;
  color: #1976d2;
}

.role-merchant {
  background-color: #fff3e0;
  color: #ff9800;
}

.role-user {
  background-color: #e8f5e9;
  color: #4caf50;
}

/* 禁言相关样式 */
.tags-container {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: flex-end;
}

.silence-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  background-color: #ffebee;
  color: #f44336;
}

.silence-info {
  display: block;
  font-size: 24rpx;
  color: #f44336;
  margin-top: 8rpx;
  font-weight: bold;
}

.silence-reason {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  border: none;
  transition: all 0.3s;
}

.btn::after {
  border: none;
}

.btn.silence {
  background-color: #f44336;
  color: white;
}

.btn.silence:active {
  background-color: #d32f2f;
}

.btn.unsilence {
  background-color: #4caf50;
  color: white;
}

.btn.unsilence:active {
  background-color: #388e3c;
}

