<!-- packageProfile/pages/privilege/merchant/ticket_sale/ticket_sale.wxml -->
<view class="ticket-sale-container">
  <!-- 页面标题 -->
  <view class="page-title">门票销售情况</view>
  
  <!-- 统计卡片 -->
  <view class="stats-container">
    <view class="stat-card">
      <view class="stat-value">{{totalSales}}</view>
      <view class="stat-label">总销售</view>
    </view>
    <view class="stat-card">
      <view class="stat-value">{{totalRefunds}}</view>
      <view class="stat-label">总退票量</view>
    </view>
    <view class="stat-card">
      <view class="stat-value">¥{{totalAmount}}</view>
      <view class="stat-label">预计收益</view>
    </view>
  </view>
  
  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading">
    <text>加载中...</text>
  </view>
  
  <!-- 无销售记录 -->
  <view wx:elif="{{ticketSales.length === 0}}" class="empty">
    <text>暂无销售记录</text>
  </view>
  
  <!-- 销售记录列表 -->
  <view wx:else class="ticket-list">
    <view wx:for="{{ticketSales}}" wx:key="_id" class="ticket-item {{item.isRefunded ? 'refunded' : ''}}">
      <!-- 基本信息 -->
      <view class="ticket-header">
        <view class="scenic-info">
          <view class="scenic-name">{{item.scenicName}}</view>
          <view class="ticket-name">{{item.ticketName}}</view>
        </view>
        <view class="status-tag {{item.isRefunded ? 'refunded-tag' : 'normal-tag'}}">
          {{item.isRefunded ? '已退票' : '正常'}}
        </view>
      </view>
      
      <!-- 销售详情 -->
      <view class="ticket-details">
        <view class="detail-row">
          <text class="detail-label">用户：</text>
          <text class="detail-value">{{item.userName}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">数量：</text>
          <text class="detail-value">{{item.quantity}}张</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">单价：</text>
          <text class="detail-value">¥{{item.price}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">总价：</text>
          <text class="detail-value total">¥{{item.totalPrice}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">购买时间：</text>
          <text class="detail-value">{{item.formattedCreatedAt}}</text>
        </view>
        <view wx:if="{{item.isRefunded}}" class="detail-row">
          <text class="detail-label">退票时间：</text>
          <text class="detail-value">{{item.formattedRefundTime}}</text>
        </view>
      </view>
    </view>
  </view>
</view>