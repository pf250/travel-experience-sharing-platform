/* packageProfile/pages/privilege/merchant/ticket_sale/ticket_sale.wxss */

.ticket-sale-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

/* 页面标题 */
.page-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  color: #333;
  margin-bottom: 30rpx;
}

/* 统计卡片容器 */
.stats-container {
  display: flex;
  justify-content: space-between;
  margin-bottom: 30rpx;
  gap: 20rpx;
}

/* 统计卡片 */
.stat-card {
  flex: 1;
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6b35;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 销售记录列表 */
.ticket-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 销售记录项 */
.ticket-item {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

/* 已退票记录样式 */
.ticket-item.refunded {
  background-color: #f9f9f9;
  border-left: 4rpx solid #f44336;
}

/* 记录头部 */
.ticket-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.scenic-info {
  flex: 1;
}

.scenic-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.ticket-name {
  font-size: 24rpx;
  color: #666;
}

/* 状态标签 */
.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.normal-tag {
  background-color: #e8f5e9;
  color: #4caf50;
}

.refunded-tag {
  background-color: #ffebee;
  color: #f44336;
}

/* 销售详情 */
.ticket-details {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 用户信息部分 */
.user-info-section {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background-color: #f9f9f9;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

/* 用户头像 */
.user-avatar {
  margin-right: 16rpx;
}

.user-avatar image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
}

/* 用户详情 */
.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.detail-label {
  color: #999;
  width: 140rpx;
}

.detail-value {
  color: #333;
  flex: 1;
}

.detail-value.total {
  font-weight: bold;
  color: #ff6b35;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .ticket-sale-container {
    padding: 16rpx;
  }
  
  .stats-container {
    flex-direction: column;
  }
  
  .stat-card {
    margin-bottom: 16rpx;
  }
  
  .ticket-item {
    padding: 20rpx;
  }
  
  .detail-row {
    font-size: 22rpx;
  }
  
  .detail-label {
    width: 120rpx;
  }
}